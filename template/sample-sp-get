[CmdletBinding()]
    param (
        [parameter()]
        [string]$param1,
        [string]$param2
    )
    $StoredProcedure = 'dbo.storedproc...'
    $connection = New-spSqlConnection -StoredProcedureName $StoredProcedure
    $conn = $connection[0]
    $cmd = $connection[1]

     try{
        Write-Information -Message "Get $($something)"

        $cmd.Parameters.Add((New-Object Data.SqlClient.SqlParameter("@param1", [System.Data.SqlDbType]::Varchar, 100)))|Out-Null
        $cmd.Parameters.Add((New-Object Data.SqlClient.SqlParameter("@param2", [System.Data.SqlDbType]::Varchar, 100)))|Out-Null
        $cmd.Parameters[0].Value = $param1
        $cmd.Parameters[1].Value = $param2
        

        $result = $cmd.ExecuteReader()
        $data = New-Object System.Data.DataTable
        $data.Load($result)
        return $data

    } catch {
        Write-Warning "$($MyInvocation.MyCommand.Name) failed : $($_.Exception.Message)"
        continue
    } finally {
        Write-Verbose -Message "$($MyInvocation.MyCommand.Name):Closing Sql Connection"
        Close-spSqlConnection -cmd $cmd -conn $conn
    }